 const an=c.createAnalyser();an.fftSize=512;g.connect(k);k.connect(c.destination);k.connect(an);g.an=an;mstC.set(c,g);return g}

/* built-in effects: each builder returns {in,out,upd(p),kill?} and is used for live playback and for export */
const GEQ=[31,62,125,250,500,1000,2000,4000,8000,16000];
const FXD={
 geq:{name:'Graphic EQ',p:()=>({g:Array(10).fill(0)})},
 filt:{name:'Filter',p:()=>({type:'lowpass',f:8000,q:.7})},
 comp:{name:'Compressor',p:()=>({th:-18,ratio:3,atk:10,rel:160,mk:0})},
 rev:{name:'Reverb',p:()=>({mix:.25,decay:1.8,damp:7000})},
 dly:{name:'Delay',p:()=>({time:.3,fb:.35,mix:.25})},
 cho:{name:'Chorus',p:()=>({rate:.8,depth:.5,mix:.4})},
