$('#split').onclick=()=>{const r=cur();if(!r)return;const[t,i]=r,c=t.clips[i];if(S.ph<=c.start+.05||S.ph>=c.start+c.dur-.05){toast('Tap inside the clip where you want to cut');return}const d=S.ph-c.start;t.clips.splice(i+1,0,{...c,id:uid(),start:S.ph,off:c.off+d,dur:c.dur-d});c.dur=d;commit()};
