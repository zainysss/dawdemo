<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#09090b"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="mobile-web-app-capable" content="yes">
<title>Studio</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f3f3f6;--card:#fff;--card2:#ebebf0;--card3:#dcdce3;--fg:#16161b;--mut:#6b6b77;--acc:#ff4433;--line:rgba(0,0,0,.09);--line2:rgba(0,0,0,.18);--lane:#e6e6ec;--fxc:#0fae92;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#09090b;--card:#131317;--card2:#1c1c22;--card3:#2a2a33;--fg:#f4f4f6;--mut:#8e8e9a;--line:rgba(255,255,255,.08);--line2:rgba(255,255,255,.16);--lane:#101014;--fxc:#2ee6c5}}
:root[data-theme="dark"]{--bg:#09090b;--card:#131317;--card2:#1c1c22;--card3:#2a2a33;--fg:#f4f4f6;--mut:#8e8e9a;--line:rgba(255,255,255,.08);--line2:rgba(255,255,255,.16);--lane:#101014;--fxc:#2ee6c5}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
[hidden]{display:none!important}
body{margin:0;height:100%;background:var(--bg);color:var(--fg);font:14px/1.35 Inter,-apple-system,system-ui,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}
#app{height:100%;display:flex;flex-direction:column}
button,select{font:inherit;color:var(--fg);background:var(--card2);border:0;border-radius:10px;padding:8px 12px;cursor:pointer}
button:disabled{opacity:.45}
button.on,button.acc{background:var(--acc);color:#fff}
.ic{display:grid;place-items:center;width:42px;height:42px;padding:0;border-radius:50%;flex:none;background:transparent}
.ic.sm{width:34px;height:34px}
.ic svg{width:22px;height:22px}.ic.sm svg{width:18px;height:18px}
svg:not(.ln){fill:currentColor}.ln{fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.grow{flex:1}
input[type=range]{-webkit-appearance:none;appearance:none;height:28px;background:transparent;margin:0}
input[type=range]::-webkit-slider-runnable-track{height:4px;border-radius:2px;background:var(--card3)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:var(--fg);margin-top:-7px;border:0;box-shadow:0 1px 4px rgba(0,0,0,.4)}
input[type=range]::-moz-range-track{height:4px;border-radius:2px;background:var(--card3)}
input[type=range]::-moz-range-thumb{width:18px;height:18px;border-radius:50%;background:var(--fg);border:0}
.chip{border-radius:999px;padding:6px 13px;font-size:13px;font-weight:500;background:var(--card2)}
/* top bar */
#top{display:flex;align-items:center;gap:10px;padding:8px 12px}
.pjb{display:flex;align-items:center;gap:6px;min-width:0;max-width:34%;background:transparent;padding:6px 4px;font-weight:700;font-size:16px}
.pjb span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pjb svg{width:16px;height:16px;flex:none;color:var(--mut)}
.tabs{display:flex;background:var(--card);border:1px solid var(--line);border-radius:999px;padding:3px;margin:0 auto}
.tabs button{background:transparent;border-radius:999px;padding:6px 12px;font-weight:600;color:var(--mut)}
.tabs button.on{background:var(--card3);color:var(--fg)}
#pm{position:fixed;top:calc(env(safe-area-inset-top,0px) + 52px);left:12px;z-index:9;min-width:240px;max-width:calc(100vw - 24px);max-height:60vh;overflow:auto;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:6px;box-shadow:0 12px 40px rgba(0,0,0,.45)}
#pm .mi{display:block;width:100%;text-align:left;background:transparent;border-radius:8px;padding:10px 12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#pm .mi:active,#pm .mi.cur{background:var(--card2)}#pm .sep{height:1px;background:var(--line);margin:6px 4px}#pm .mh{font-size:11px;color:var(--mut);padding:4px 12px;text-transform:uppercase;letter-spacing:.08em}
/* timeline */
#view{flex:1;min-height:0;overflow:auto}
.tl{position:relative;min-height:100%}
.ruler{position:sticky;top:0;z-index:4;display:flex;height:26px;background:var(--bg);border-bottom:1px solid var(--line);cursor:pointer}
.ruler .corner{position:sticky;left:0;z-index:2;width:100px;flex:none;background:var(--bg)}
.rb{position:relative;flex:none}.rb span{position:absolute;top:7px;font-size:10px;font-weight:600;color:var(--mut)}
.row{display:flex;margin:6px 0}
.th{position:sticky;left:0;z-index:3;width:100px;height:84px;flex:none;background:var(--card);border-left:4px solid var(--acc);border-radius:0 12px 12px 0;padding:8px 8px 8px 10px;display:flex;flex-direction:column;justify-content:space-between;cursor:pointer;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.th.on{background:var(--card2)}
.th b{font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tbar{display:flex;gap:4px;align-items:center}
.tbar button{width:26px;height:24px;padding:0;font-size:11px;font-weight:700;border-radius:6px;background:var(--card2);display:grid;place-items:center;position:relative}
.th.on .tbar button{background:var(--bg)}.tbar button.on{background:var(--acc);color:#fff}
.tbar svg{width:14px;height:14px}.tbar .nb{position:absolute;top:-5px;right:-4px;min-width:14px;height:14px;border-radius:7px;background:var(--fxc);color:#04201a;font-size:9px;font-weight:700;display:grid;place-items:center;padding:0 3px}
.lane{position:relative;flex:none;height:84px;background:var(--lane);background-image:linear-gradient(90deg,var(--line2) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:var(--bar) 100%,var(--beat,40px) 100%;border-radius:0 12px 12px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.lane.on{box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--acc) 70%,transparent)}
.clip{position:absolute;top:7px;height:68px;border-radius:8px;border:2px solid transparent;touch-action:pan-x pan-y;box-shadow:0 1px 0 rgba(255,255,255,.18) inset}
.clip.sel{border-color:var(--fg);touch-action:none}
.clip canvas{width:100%;height:100%;display:block;border-radius:6px;pointer-events:none}
.cl{position:absolute;left:6px;top:3px;font-size:9px;font-weight:800;letter-spacing:.08em;color:rgba(0,0,0,.6);pointer-events:none}
.hd{position:absolute;top:12px;bottom:12px;width:8px;background:var(--fg);border-radius:4px;touch-action:none}.hd::after{content:"";position:absolute;inset:-10px -12px}.hd.l{left:-6px}.hd.r{right:-6px}
.ph{position:absolute;top:0;bottom:0;left:0;width:2px;background:var(--acc);z-index:5;pointer-events:none;box-shadow:0 0 8px rgba(255,68,51,.6)}
.hint{margin:28px auto;text-align:center;color:var(--mut);position:sticky;left:0;width:calc(100vw - 24px)}
.zoom{position:fixed;right:12px;bottom:calc(158px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:999px;z-index:6}
.zoom .ic{width:36px;height:36px}
/* bars */
#clipbar{display:flex;justify-content:center;gap:6px;padding:6px 12px;flex-wrap:wrap}
#clipbar button{display:flex;align-items:center;gap:6px;border-radius:999px;padding:7px 13px;font-weight:600;font-size:13px;background:var(--card2)}
#clipbar button svg{width:16px;height:16px}#clipbar button.acc{background:var(--acc)}
#seekrow{display:flex;align-items:center;gap:6px;padding:2px 14px}
#seekrow input{flex:1;min-width:0}#seekrow button{padding:4px 6px;background:transparent;color:var(--mut);font-size:12px;font-weight:600}
#time{font-variant-numeric:tabular-nums;font-weight:600;font-size:13px;min-width:54px;color:var(--fg)}
#tb{display:flex;align-items:center;justify-content:space-between;padding:6px 14px 12px}
.ctr{display:flex;align-items:center;gap:10px;min-width:98px}.ctr:last-child{justify-content:flex-end}
#imp,#add,#rw,#fxb{color:var(--mut)}
#pl{background:var(--fg);color:var(--bg);width:48px;height:48px}
#rc{background:var(--acc);color:#fff;width:62px;height:62px;box-shadow:0 4px 16px rgba(255,68,51,.35)}#rc svg{width:34px;height:34px}
#rc.rec{box-shadow:0 0 0 6px rgba(255,68,51,.3)}
/* mixer */
.mix{display:flex;gap:8px;padding:12px;width:max-content;min-height:100%}
.strip{width:96px;background:var(--card);border:1px solid var(--line);border-top:3px solid var(--c,var(--acc));border-radius:12px;padding:8px;display:flex;flex-direction:column;align-items:center;gap:8px}
.strip.on{border-color:var(--c,var(--acc))}.strip.master{--c:var(--fg);width:104px;margin-left:8px}
.sn{width:100%;text-align:center;cursor:pointer}.sn b{font-size:12px;font-weight:600}
.slots{width:100%;display:flex;flex-direction:column;gap:3px;cursor:pointer}
.slot{font-size:10px;font-weight:500;padding:4px 6px;border-radius:5px;background:var(--card2);color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center}
.slot.on{background:color-mix(in srgb,var(--fxc) 22%,var(--card2));color:var(--fg)}.slot.off{text-decoration:line-through}.slot.more{color:var(--mut)}
.fxbtn{width:100%;font-size:12px;font-weight:600;padding:6px}
.strip input[type=range]{width:78px}
.fm{display:flex;gap:8px;align-items:flex-end;height:170px}
.met{position:relative;width:8px;height:170px;border-radius:4px;background:var(--card2);overflow:hidden}
.met i{position:absolute;left:0;right:0;bottom:0;height:0;background:linear-gradient(0deg,#19c9a4 0%,#19c9a4 60%,#ffcc00 80%,#ff4433 100%);background-size:100% 170px;background-position:bottom}
.fader{position:relative;width:34px;height:170px}
.fader input{position:absolute;left:0;top:0;width:170px;transform-origin:0 0;transform:translateY(170px) rotate(-90deg)}
.db{font-size:11px;font-weight:600;color:var(--mut);font-variant-numeric:tabular-nums}
.ms{display:flex;gap:6px}.ms button{width:32px;height:28px;padding:0;font-size:12px;font-weight:700;border-radius:7px}.ms button.on{background:var(--acc);color:#fff}
/* effects rack */
#fx{position:fixed;inset:0;z-index:7;background:var(--bg);overflow:auto;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
.fxw{max-width:560px;margin:0 auto;padding:10px 14px 28px;display:flex;flex-direction:column;gap:12px}
.fxh{display:flex;align-items:center;gap:10px;font-size:16px}.fxh .dot{width:10px;height:10px;border-radius:50%}
.fxl{display:flex;flex-direction:column;gap:10px}
.fxc{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:10px 12px 12px}.fxc.off .fxb{opacity:.4}
.fxt{display:flex;align-items:center;gap:6px;margin-bottom:6px}.fxt b{font-size:14px}
.pw{color:var(--mut)}.pw.on{color:var(--fxc)}
.fxb{display:flex;flex-direction:column;gap:2px}
.pr{display:grid;grid-template-columns:84px 1fr 68px;align-items:center;gap:8px;font-size:12px;color:var(--mut)}.pr b{color:var(--fg);font-weight:600;text-align:right;font-variant-numeric:tabular-nums}
.seg2{display:flex;gap:6px;margin-bottom:6px}.seg2 .chip.on{background:var(--fxc);color:#04201a}
.fxadd{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.fxadd .lbl{width:100%;font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.08em}
.hint2{color:var(--mut);text-align:center;padding:24px 0}
.eq{display:flex;flex-direction:column;gap:8px}.eqc{width:100%;height:auto;background:var(--lane);border-radius:10px;border:1px solid var(--line)}
.eqb{display:flex;justify-content:space-between}.eqk{display:flex;flex-direction:column;align-items:center;gap:4px;font-size:10px;color:var(--mut)}.eqk i{font-style:normal;font-weight:600;color:var(--fg);font-size:10px;font-variant-numeric:tabular-nums}
.eqf{position:relative;width:26px;height:124px}.eqf input{position:absolute;left:0;top:0;width:124px;transform-origin:0 0;transform:translateY(124px) rotate(-90deg)}
.eq .chip{align-self:flex-end}
#cpw{position:fixed;inset:0;z-index:7;background:rgba(0,0,0,.5);display:flex;align-items:flex-end}
#cp{width:100%;max-width:560px;margin:0 auto;max-height:84vh;overflow:auto;background:var(--card);border:1px solid var(--line);border-radius:20px 20px 0 0;padding:14px 16px calc(20px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;gap:6px}
#cp input[type=number]{background:var(--card2);color:var(--fg);border:0;border-radius:8px;padding:8px;width:100%;font:inherit}
.nudge{display:flex;flex-wrap:wrap;gap:6px;margin:4px 0}#cpst{font-size:12px;color:var(--mut);min-height:18px;margin-top:6px}
#un,#re{color:var(--mut)}
.mrow{display:flex;align-items:center}.mrow .mi{flex:1;min-width:0}
#mtb.mon{color:var(--acc)}
#tmp{background:var(--card2);font-weight:600;font-size:12px;padding:5px 11px;white-space:nowrap;font-variant-numeric:tabular-nums;color:var(--fg)}
.bpm{display:flex;align-items:center;justify-content:center;gap:20px;margin:6px 0 2px}.bpm .ic{width:50px;height:50px;background:var(--card2);font-size:26px;font-weight:300;color:var(--fg)}
.bv{text-align:center;min-width:110px}.bv b{font-size:46px;font-weight:700;line-height:1;font-variant-numeric:tabular-nums;display:block}.bv small{color:var(--mut);font-weight:600;letter-spacing:.12em;font-size:11px}
.sw{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 2px;border-top:1px solid var(--line)}.sw b{font-weight:600}.sw small{display:block;color:var(--mut);font-size:12px;margin-top:2px}
.sw input{-webkit-appearance:none;appearance:none;flex:none;width:46px;height:28px;border-radius:14px;background:var(--card3);position:relative;transition:background .15s;cursor:pointer;margin:0}
.sw input::after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:transform .15s;box-shadow:0 1px 3px rgba(0,0,0,.4)}
.sw input:checked{background:var(--acc)}.sw input:checked::after{transform:translateX(18px)}
.sigs{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0}.sigs .chip.on{background:var(--acc);color:#fff}
.tname{flex:1;min-width:0;background:transparent;color:var(--fg);font:inherit;font-weight:700;font-size:17px;border:0;border-bottom:1px solid var(--line);padding:4px 0;outline:0}
.dangerb{align-self:flex-start;color:#ff6b5e;margin-top:6px}
#sbk{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:5}
#sb{position:fixed;top:0;bottom:0;left:0;width:min(88vw,360px);z-index:6;background:var(--card);border-right:1px solid var(--line);transform:translateX(-102%);transition:transform .22s ease;overflow:auto;padding:calc(env(safe-area-inset-top,0px) + 12px) 14px calc(env(safe-area-inset-bottom,0px) + 20px);display:flex;flex-direction:column;gap:10px;box-shadow:12px 0 40px rgba(0,0,0,.4)}
#sb.open{transform:none}
.sbh{display:flex;align-items:center;gap:10px}.sbh .dot{width:12px;height:12px;border-radius:50%;flex:none}
.sbs{font-size:11px;font-weight:700;color:var(--mut);text-transform:uppercase;letter-spacing:.09em;margin-top:8px}.sbg{font-size:12px;color:var(--mut);margin-top:2px}
.sbr{display:flex;gap:6px;flex-wrap:wrap}.sbr button{border-radius:999px;padding:7px 14px;font-weight:600;font-size:13px}.sbr .chip{display:inline-flex;align-items:center;gap:6px}.sbr .chip svg{width:16px;height:16px}
.sbc{display:flex;gap:10px}.sbc button{width:30px;height:30px;padding:0;border-radius:50%;border:2px solid transparent}.sbc button.on{border-color:var(--fg)}
#toast{position:fixed;left:50%;bottom:calc(120px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--fg);color:var(--bg);padding:9px 15px;border-radius:12px;opacity:0;pointer-events:none;transition:opacity .2s;max-width:90%;text-align:center;z-index:12;font-weight:500}
#toast.show{opacity:1}
#ex{position:fixed;inset:0;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;z-index:11}
#ex .card{background:var(--card);border:1px solid var(--line);padding:16px;border-radius:16px;display:flex;flex-direction:column;gap:12px;width:min(340px,92%)}
#ex .row2{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}#exmsg{font-size:12px;color:var(--mut)}
/* tuner (always dark, like a plugin window) */
#tp{position:fixed;inset:0;z-index:8;background:#0d0f13;color:#e8eaf0;overflow:auto;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
#tp button{background:#1d2028;color:#e8eaf0}
#tp input[type=range]::-webkit-slider-thumb{background:#e8eaf0}#tp input[type=range]::-webkit-slider-runnable-track{background:#2a2e39}
.mt{max-width:560px;margin:0 auto;padding:10px 14px 24px;display:flex;flex-direction:column;gap:12px}
.mtbar{display:flex;align-items:center;gap:8px}.mtlogo{letter-spacing:.2em;font-size:13px;color:#2ee6c5}.mtname{color:#8b90a0;font-size:12px}
.ab{padding:6px 12px;border-radius:8px}#tp .ab.on{background:#2ee6c5;color:#06201b}
.gwrap{background:#12151b;border:1px solid #232733;border-radius:14px;overflow:hidden}#mtg{width:100%;height:auto;display:block}
#mtstat{font-size:12px;color:#8b90a0;min-height:30px}
.kwrap{background:#12151b;border:1px solid #232733;border-radius:14px;padding:10px 10px 12px}
#mtlab,#mthm,#mtkeys{position:relative}#mtlab{height:20px}#mthm{height:40px}#mtkeys{height:112px}
.lb{position:absolute;top:0;transform:translateX(-50%);font-size:11px;color:#8b90a0;padding:2px 3px;border-radius:5px;background:transparent!important}
#tp .lb.on{color:#06201b;background:#2ee6c5!important}
.hm{position:absolute;bottom:2px;transform:translateX(-50%);height:36px;display:flex;gap:2px;align-items:flex-end}
.hi,.ho{width:5px;border-radius:2px 2px 0 0;min-height:1px;height:1px}.hi{background:#ff9f1a}.ho{background:#2ee6c5}
#tp .wk,#tp .bk{position:absolute;top:0;padding:0;border-radius:0 0 7px 7px}
#tp .wk{height:100%;background:#d9dce4;border:1px solid #0d0f13}#tp .wk.on{background:linear-gradient(#c7f8ee,#2ee6c5)}
#tp .bk{height:62%;width:8.4%;transform:translateX(-50%);background:#23262e;z-index:2}#tp .bk.on{background:#0fa88f}
.det{position:absolute;top:-6px;left:25%;right:25%;height:3px;border-radius:2px;background:#fff;display:none}.det.on{display:block}
.mtrow{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.mtrow .lbl{font-size:11px;color:#8b90a0;width:74px}
#tp .chip{border-radius:999px;padding:6px 14px;font-size:13px}#tp .chip.on{background:#2ee6c5;color:#06201b}
.knobs{justify-content:space-around;background:#12151b;border:1px solid #232733;border-radius:14px;padding:10px 4px}
.knob{touch-action:none;text-align:center;user-select:none}.knob svg{width:80px;height:80px}
.kt{fill:none;stroke:#2a2e39;stroke-width:7;stroke-linecap:round}.kv{fill:none;stroke:#2ee6c5;stroke-width:7;stroke-linecap:round}
.knob text{fill:#fff;font-size:14px;font-weight:700}.kn{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#8b90a0;margin-top:-4px}
#tp .go{background:#2ee6c5;color:#06201b;font-weight:800;font-size:16px;padding:14px;border-radius:14px}

/* ===================== studio skin: graphite panels, glossy colour, LCD readouts ===================== */
:root{--mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;--acc:#ff8a1f;--acc2:#ffc26b;--onacc:#1a1206;--rec:#ff3b30;--ok:#74e05a;--lcd:#ffb23f;--lcdbg:#140e05;--panel:linear-gradient(180deg,var(--card2),var(--card))}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#13161b;--card:#1c2027;--card2:#252a32;--card3:#343b46;--fg:#eef1f5;--mut:#8c97a6;--line:rgba(255,255,255,.07);--line2:rgba(255,255,255,.15);--lane:#161920;--fxc:#35e0c2}}
:root[data-theme="dark"]{--bg:#13161b;--card:#1c2027;--card2:#252a32;--card3:#343b46;--fg:#eef1f5;--mut:#8c97a6;--line:rgba(255,255,255,.07);--line2:rgba(255,255,255,.15);--lane:#161920;--fxc:#35e0c2}
:root[data-accent="cyan"]{--acc:#22c7e8;--acc2:#8cecff}
