};
const FXB={
 geq(c,p){const fs=GEQ.map((f,i)=>{const b=c.createBiquadFilter();b.type=i?i===9?'highshelf':'peaking':'lowshelf';b.frequency.value=f;b.Q.value=1.1;b.gain.value=p.g[i];return b});
