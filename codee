  const A=(p,l)=>{const k=1+p.drive*24,cv=new Float32Array(1024),th=Math.tanh(k);for(let i=0;i<1024;i++)cv[i]=Math.tanh(k*(i/511.5-1))/th;ws.curve=cv;V(wet.gain,p.mix,l);V(dry.gain,1-p.mix,l)};A(p,0);return{in:inp,out,upd:p=>A(p,1)}}
