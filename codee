const newName=()=>'Project '+new Date().toISOString().slice(5,16).replace('T',' ').replace(':','.');
function h(t,p={},...k){const e=document.createElement(t);for(const a in p){if(a==='style'){for(const q in p[a])q.startsWith('--')?e.style.setProperty(q,p[a][q]):e.style[q]=p[a][q]}else if(a.startsWith('on'))e[a]=p[a];else if(a in e)e[a]=p[a];else e.setAttribute(a,p[a])}e.append(...k);return e}

/* ---------- audio graph (shared by live playback and export) ---------- */
const smooth=(p,v)=>ctx?p.setTargetAtTime(v,ctx.currentTime,.015):(p.value=v);
