 comp(c,p){const k=c.createDynamicsCompressor(),m=c.createGain();k.knee.value=6;k.connect(m);
  const A=(p,l)=>{V(k.threshold,p.th,l);V(k.ratio,p.ratio,l);V(k.attack,p.atk/1000,l);V(k.release,p.rel/1000,l);V(m.gain,Math.pow(10,p.mk/20),l)};A(p,0);return{in:k,out:m,upd:p=>A(p,1)}},
 rev(c,p){const inp=c.createGain(),out=c.createGain(),cv=c.createConvolver(),lp=c.createBiquadFilter(),w=c.createGain();
  inp.connect(out);inp.connect(cv);cv.connect(lp);lp.connect(w);w.connect(out);cv.buffer=ir(c,p.decay);let tm,cd=p.decay;
  const A=(p,l)=>{V(w.gain,p.mix,l);V(lp.frequency,p.damp,l);if(l&&Math.abs(p.decay-cd)>.05){cd=p.decay;clearTimeout(tm);tm=setTimeout(()=>{cv.buffer=ir(c,cd)},150)}};A(p,0);return{in:inp,out,upd:p=>A(p,1)}},
 dly(c,p){const inp=c.createGain(),out=c.createGain(),d=c.createDelay(2),fb=c.createGain(),w=c.createGain();
